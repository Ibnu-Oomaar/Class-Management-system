  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  // Get a free hosted Postgres database in seconds: `npx create-db`

  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }

  // ============================================================
  // ENUMS
  // ============================================================

  enum StudentStatus {
    active
    suspended
    rejected
    transferred
  }

enum Role {
  main_monitor
  assistant_monitor
  discipline_leader
  sports_leader
  education_leader
  student
}

  enum DisciplineSeverity {
    low
    medium
    high
    critical
  }

  enum DisciplineAction {
    warning
    recorded
    referred_to_admin
    class_rejection
  }

  enum ImpactType {
    positive
    negative
  }

  enum AchievementType {
    academic
    leadership
    sports
    discipline
    community
  }

  enum CompetitionType {
    football
    quiz
    academic
  }

model Student {
  id Int @id @default(autoincrement())

  // ==========================================================
  // LOGIN / IDENTIFICATION
  // ==========================================================

  student_code String @unique

  role Role @default(student)

  // ==========================================================
  // PERSONAL INFORMATION
  // ==========================================================

  first_name  String
  middle_name String
  last_name   String
  phone       String @unique





  // ==========================================================
  // STATUS
  // ==========================================================

  status StudentStatus @default(active)

  // ==========================================================
  // STUDENT RECORDS
  // ==========================================================

  achievements     Achievement[]
  discipline_cases DisciplineCase[]
  class_impacts    ClassImpact[]
  competitions     CompetitionParticipant[]

  // Only students who are leaders have this record
  class_leaders ClassLeader?

  // ==========================================================
  // TIMESTAMPS
  // ==========================================================

  registered_at DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // ==========================================================
  // RECYCLE BIN
  // ==========================================================

  deleted_at DateTime?

  // ==========================================================
  // INDEXES
  // ==========================================================


  @@index([status])
  @@index([role])
  @@index([deleted_at])
  @@map("student")
}


  // CLASS LEADER


  model ClassLeader {
    id Int @id @default(autoincrement())
    student_id Int     @unique
    student    Student @relation( fields: [student_id],  references: [id])

    // RECORDS REGISTERED BY LEADER


    achievements Achievement[]@relation("achievement_registered_by")

    discipline_cases DisciplineCase[]@relation("discipline_registered_by")

    class_impacts ClassImpact[]@relation("impact_registered_by")

    // TIMESTAMPS


    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([deleted_at])
    @@map("class_leader")
  }

  // ============================================================
  // ACHIEVEMENT
  // ============================================================

  model Achievement {
    id Int @id @default(autoincrement())

    title       String
    description String?
    type        AchievementType
    points      Int      @default(0)
    achieved_at DateTime @default(now())

    // ==========================================================
    // STUDENT
    // ==========================================================

    student_id Int
    student    Student @relation(fields: [student_id],  references: [id])

    // ==========================================================
    // REGISTERED BY CLASS LEADER
    // ==========================================================

    registered_by_id Int

    registered_by ClassLeader @relation( "achievement_registered_by",  fields: [registered_by_id],  references: [id])

    // ==========================================================
    // TIMESTAMPS
    // ==========================================================

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([student_id])
    @@index([registered_by_id])
    @@index([type])
    @@index([achieved_at])
    @@index([deleted_at])
    @@map("achievement")
  }

  // ============================================================
  // DISCIPLINE CASE
  // ============================================================

  model DisciplineCase {
    id Int @id @default(autoincrement())

    title         String
    description   String
    severity      DisciplineSeverity
    action        DisciplineAction
    incident_date DateTime @default(now())

    // ==========================================================
    // STUDENT
    // ==========================================================

    student_id Int
    student    Student @relation(fields: [student_id],  references: [id])

    // ==========================================================
    // REGISTERED BY CLASS LEADER
    // ==========================================================

    registered_by_id Int

    registered_by ClassLeader @relation("discipline_registered_by",  fields: [registered_by_id],  references: [id])

    // ==========================================================
    // TIMESTAMPS
    // ==========================================================

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([student_id])
    @@index([registered_by_id])
    @@index([severity])
    @@index([incident_date])
    @@index([deleted_at])
    @@map("discipline_case")
  }

  // ============================================================
  // CLASS IMPACT
  // ============================================================

  model ClassImpact {
    id Int @id @default(autoincrement())

    title       String
    description String?
    type        ImpactType
    points      Int      @default(0)
    impact_date DateTime @default(now())

    // ==========================================================
    // STUDENT
    // ==========================================================

    student_id Int
    student    Student @relation( fields: [student_id],  references: [id])

    // ==========================================================
    // REGISTERED BY CLASS LEADER
    // ==========================================================

    registered_by_id Int

    registered_by ClassLeader @relation("impact_registered_by",  fields: [registered_by_id],  references: [id])

    // ==========================================================
    // TIMESTAMPS
    // ==========================================================

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

    @@index([student_id])
    @@index([registered_by_id])
    @@index([type])
    @@index([impact_date])
    @@index([deleted_at])
    @@map("class_impact")
  }

  // ============================================================
  // COMPETITION
  // ============================================================

  model Competition {
    id Int @id @default(autoincrement())

    name        String
    description String?
    type        CompetitionType

    start_date DateTime
    end_date   DateTime?

    // ==========================================================
    // CLASS
    // ==========================================================



    participants CompetitionParticipant[]

    // ==========================================================
    // TIMESTAMPS
    // ==========================================================

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime?

  
    @@index([type])
    @@index([start_date])
    @@index([deleted_at])
    @@map("competition")
  }

  // ============================================================
  // COMPETITION PARTICIPANT
  // ============================================================

  model CompetitionParticipant {
    id Int @id @default(autoincrement())

    // ==========================================================
    // STUDENT
    // ==========================================================

    student_id Int
    student    Student @relation(fields: [student_id],  references: [id])

    // ==========================================================
    // COMPETITION
    // ==========================================================

    competition_id Int

    competition Competition @relation(fields: [competition_id],  references: [id])

    position  String?
    points    Int      @default(0)
    joined_at DateTime @default(now())

    deleted_at DateTime?

    @@unique([student_id, competition_id])
    @@index([student_id])
    @@index([competition_id])
    @@index([deleted_at])
    @@map("competition_participant")
  }
